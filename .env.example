# =====================================================================
# SmartGarage AI (Next.js) - Environment variables
# Copy this file to ".env.local" for local development, and add the SAME
# variables in Vercel: Project -> Settings -> Environment Variables.
# =====================================================================

# ---------- Firebase web config (PUBLIC - identifies your project) ----------
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Where vehicle images are stored:
#   firestore = compressed image saved in Cloud Firestore (works on the FREE Spark plan)
#   storage   = Cloud Storage for Firebase (needs the Blaze plan on new projects)
NEXT_PUBLIC_IMAGE_STORAGE=firestore

# ---------- Google Gemini (SECRET - server only, NO "NEXT_PUBLIC_" prefix) ----------
# Get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model used by the API route (change if Google retires it)
GEMINI_MODEL=gemini-2.5-flash
